# --- Identity ---------------------------------------------------------------
AGENT_NAME=nudge
OWNER_ID=owner
OWNER_NAME=Owner
# Data lives under the workspace root at <root>/<AGENT_NAME> (default ~/.agentkit/nudge).
AGENTKIT_HOME=~/.agentkit
# Optional explicit home override (blank = AGENTKIT_HOME/AGENT_NAME).
AGENT_HOME=
LOG_LEVEL=INFO
LOG_JSON=false

# --- Model / provider (any OpenAI-compatible endpoint) ----------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=openai:gpt-4o-mini
MODEL_TIMEOUT=60
MODEL_RETRIES=2

# --- Observability (on by default, self-hosted, no account) -----------------
#   phoenix | console | otlp | off
OBSERVABILITY=phoenix
OTLP_ENDPOINT=

# --- Reminders --------------------------------------------------------------
# Where a nudge goes when a target is not given: local | telegram | both
NUDGE_DEFAULT_TARGET=local

# --- Telegram (optional) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma/space separated chat ids. The first entry is used as the owner chat
# for proactive nudge delivery.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- A2A / MCP servers ------------------------------------------------------
A2A_PUBLIC_URL=http://127.0.0.1:9200
A2A_HOST=127.0.0.1
A2A_PORT=9200
MCP_HOST=127.0.0.1
MCP_PORT=8960
PEERS_FILE=

# --- Web UI (served by `nudge up`; loopback only) ---------------------------
WEBUI_ENABLED=true
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8787
